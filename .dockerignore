# the build needs the sources, pyproject.toml, uv.lock and .git (version from tags).
# Only untracked files here: a left-out tracked file makes the git tree dirty and the
# version wrong (e.g. 0.6.0+d20261103 instead of 0.6.0).
data
paper
references
.venv
dist
build
coverage.xml
.coverage
**/__pycache__
**/*.pyc
**/*.log
**/.DS_Store
.vscode
.idea
PLAN-*.md
.claude
