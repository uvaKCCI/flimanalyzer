{
  "schema_version": 1,
  "name": "Import",
  "description": "Renames and drops the channels' columns, joins the tables into one and calculates the FLIM features (as FLIMAnalyzer 0.6's import did with the default filename parser).",
  "tags": ["import"],
  "steps": [
    {
      "id": "1",
      "tool": "Rename Columns",
      "processing": "allow_none",
      "config": {
        "grouping": [],
        "features": [],
        "prefix": null,
        "resources": {
          "preferred_device": "cpu",
          "preferred_threads": 1
        },
        "replacements": [
          {
            "part": "Exc1_-Ch1-_",
            "new": "trp "
          },
          {
            "part": "Exc1_-Ch2-_",
            "new": "NAD(P)H "
          },
          {
            "part": "Exc2_-Ch3-_",
            "new": "FAD "
          }
        ]
      }
    },
    {
      "id": "2",
      "tool": "Drop Columns",
      "processing": "allow_none",
      "config": {
        "grouping": [],
        "features": [],
        "prefix": null,
        "resources": {
          "preferred_device": "cpu",
          "preferred_threads": 1
        },
        "drop": [
          {
            "text": "Exc1_",
            "match": "contains"
          },
          {
            "text": "Exc2_",
            "match": "contains"
          },
          {
            "text": "Exc3_",
            "match": "contains"
          }
        ]
      }
    },
    {
      "id": "3",
      "tool": "Concatenate",
